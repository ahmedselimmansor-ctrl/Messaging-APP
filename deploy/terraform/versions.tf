terraform {
  required_version = ">= 1.9.0"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
    google-beta = {
      source  = "hashicorp/google-beta"
      version = "~> 6.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
  }

  # State lives in GCS with versioning enabled and object retention set on the
  # bucket. Terraform's own locking uses a GCS object, which is why the bucket
  # must not have a lifecycle rule that deletes small objects.
  #
  # The bucket name is supplied per environment: `terraform init -backend-config=...`
  # See envs/*/backend.hcl.
  backend "gcs" {}
}

provider "google" {
  project = var.project_id
  region  = var.region
}

provider "google-beta" {
  project = var.project_id
  region  = var.region
}
